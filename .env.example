# APPLE ESPORTS GAMING SOFTWARE
# Environment Variables Template
# Copy this file to `.env` and fill in the secrets before starting the system.

# ==========================================
# Public Base URL (REQUIRED)
# ==========================================
# Public address of THIS deployment's frontend — no trailing slash.
# Every link inside an outgoing email (password reset, welcome/setup) is built from this.
#
# It MUST be reachable FROM THE RECIPIENT'S DEVICE. Never use "localhost" here: on the
# recipient's phone, "localhost" resolves to the phone itself, so the link is always dead.
#   Local dev  -> http://<this-PC's-LAN-IP>:8081   (e.g. 192.168.x.x — phone on same WiFi)
#   Server/IP  -> http://<public-ip>:8081
#   Production -> https://your-domain.com
# If left unset, emails still send but every link points at localhost and is dead for
# the recipient — the API logs a warning on every send when this happens.
APP_BASE_URL=http://localhost:8081

# ==========================================
# Database Configuration
# ==========================================
DB_USER=postgres
DB_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD
DB_NAME=gamecafe_erp

# ==========================================
# JWT Secrets
# ==========================================
# MUST BE AT LEAST 32 CHARACTERS LONG!
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARS
JWT_REFRESH_SECRET=YOUR_SECURE_JWT_REFRESH_KEY_MIN_32_CHARS

# ==========================================
# Redis Configuration (Optional Backplane)
# ==========================================
REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD

# ==========================================
# Email / SMTP Configuration
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=YOUR_SMTP_APP_PASSWORD
SMTP_FROM_EMAIL=your_email@gmail.com
